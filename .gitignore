**/__pycache__/
**/node_modules/
*.pyc
.venv/

# Obsidian plugin caches
.obsidian/cache/

# YouTube OAuth credentials (NEVER COMMIT)
.youtube_tokens.json
.youtube_client_secret.json
youtube_tokens.json
client_secret*.json
token*.json

# AWS credentials
.aws/
.aws-*

# OAuth and secrets
oauth_token*
*credentials*
*.secret
.env.local

# Graphify generated output
.graphify-out/
graphify-out/
